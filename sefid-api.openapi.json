                          "maxLength": 120
                        },
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "price": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "salePrice": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "inStock": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "stockQty": {
                          "anyOf": [
                            {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "imageUrl": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 1000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "productUrl": {
                          "anyOf": [
                            {
                              "type": "string",
                              "maxLength": 1000
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "sku": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "shippable": {
                          "type": [
                            "boolean",
                            "null"
                          ]
                        },
                        "description": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "brand": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "categories": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "variations": {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "attributes": {
                                    "anyOf": [
                                      {
                                        "type": "object",
                                        "propertyNames": {
                                          "type": "string"
                                        },
                                        "additionalProperties": {}
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "price": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "inStock": {
                                    "type": [
                                      "boolean",
                                      "null"
                                    ]
                                  },
                                  "stockQty": {
                                    "anyOf": [
                                      {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 9007199254740991
                                      },
                                      {
                                        "type": "null"
                                      }
                                    ]
                                  },
                                  "imageUrl": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "sku": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  },
                                  "externalId": {
                                    "type": [
                                      "string",
                                      "null"
                                    ]
                                  }
                                },
                                "additionalProperties": false
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "externalId",
                        "name"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "products"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "A field is missing or wrong; the body lists which."
          },
          "401": {
            "description": "The key or the signature is not valid."
          },
          "403": {
            "description": "This key, or this site, may not call this part."
          },
          "429": {
            "description": "Too many requests."
          },
          "2XX": {
            "description": "Done."
          }
        }
      }
    },
