{
  "openapi": "3.1.0",
  "info": {
    "title": "Sefid signed API",
    "version": "v1",
    "description": "Server-to-server calls a shop makes to Sefid. Generated from the code; the guide for people is sefid-api.md. Every call is signed (see the guide, section 3). The same paths without the version (/api/ingest/...) are version 1 too."
  },
  "servers": [
    {
      "url": "https://api.sefid.dev"
    }
  ],
  "components": {
    "securitySchemes": {
      "sefidSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sefid-Signature",
        "description": "HMAC-SHA256 over METHOD, PATH, X-Sefid-Timestamp, X-Sefid-Nonce and the SHA-256 of the body, with the key's secret; sent with X-Sefid-Key, X-Sefid-Timestamp and X-Sefid-Nonce."
      }
    }
  },
  "paths": {
    "/api/v1/ingest/products": {
      "post": {
        "summary": "Send or update products (up to the plan's limit in one call).",
        "x-sefid-key-part": "products",
